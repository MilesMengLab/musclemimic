{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "train_knee_exo_hinge_128_render",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "hum_exo.train",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": false,
            "env": { "PYTHONUNBUFFERED": "1" },
            "args": [
                "device=knee_exo",
                "experiment.env_params.num_envs=128",
                "experiment.total_timesteps=30000000"
            ]
        },
        {
            "name": "train_knee_exo_hinge_128_headless",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "hum_exo.train",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": false,
            "env": { "PYTHONUNBUFFERED": "1" },
            "args": [
                "device=knee_exo",
                "experiment.env_params.num_envs=128",
                "experiment.total_timesteps=30000000",
                "--headless"
            ]
        },
        {
            "name": "play_knee_exo_hinge_1_render",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "scripts.hum_exo.play",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": false,
            "env": { "PYTHONUNBUFFERED": "1" },
            "args": [
                "--checkpoint", "${input:checkpoint}",
                "--seconds", "120",
                "--seed", "0"
            ]
        },
        {
            "name": "play_knee_exo_hinge_1_headless",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "scripts.hum_exo.play",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": false,
            "env": { "PYTHONUNBUFFERED": "1" },
            "args": [
                "--checkpoint", "${input:checkpoint}",
                "--seconds", "120",
                "--seed", "0",
                "--no-viewer"
            ]
        },
        {
            "name": "preview_knee_exo_hinge_1_render",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "scripts.hum_exo.preview",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": false,
            "env": { "PYTHONUNBUFFERED": "1" },
            "args": ["--device", "knee_exo"]
        },
        {
            "name": "fit_knee_exo_hinge_1_web",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "scripts.hum_exo.fit",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": false,
            "env": { "PYTHONUNBUFFERED": "1" },
            "args": ["--device", "knee_exo"]
        }
    ],
    "inputs": [
        {
            "id": "checkpoint",
            "type": "promptString",
            "description": "留空或仅空格播放最新完整模型；也可输入 checkpoint_编号 目录的相对路径或绝对路径",
            "default": ""
        }
    ]
}
